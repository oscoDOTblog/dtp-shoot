<!--
  DTP Shoot bench ammo readout. Placed at ~0.15 node scale so 132 units reads as
  a small instrument panel next to the pistol, not a wall display.
  Dark scheme at runtime, light in editor previews, so text colors have :dark.
-->
<style>
  .ammo-root {
    flex-direction: column;
    width: 132;
    padding-top: 8;
    padding-bottom: 9;
    padding-left: 11;
    padding-right: 11;
    gap: 1;
  }

  .ammo-label {
    color: #6b5a00;
    font-size: 7.5;
    font-weight: 700;
    letter-spacing: 0.9;
  }

  .ammo-label:dark {
    color: #f5d90a;
  }

  .ammo-value {
    color: #1c1d20;
    font-size: 34;
    font-weight: 700;
    line-height: 1;
  }

  .ammo-value:dark {
    color: #fafaf7;
  }

  .ammo-hint {
    margin-top: 1;
    color: #4a4b50;
    font-size: 10.5;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2;
  }

  .ammo-hint:dark {
    color: #d3d6dc;
  }

  .ammo-alert {
    margin-top: 1;
    color: #a03000;
    font-size: 10.5;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2;
  }

  .ammo-alert:dark {
    color: #ff8a4a;
  }
</style>
<Panel class="ammo-root">
  <span class="ammo-label">MAGAZINE</span>
  <span id="ammo-value" class="ammo-value">6 / 6</span>
  <span id="ammo-hint" class="ammo-hint">READY</span>
  <span id="ammo-alert" class="ammo-alert" style="display: none">PRESS A TO DROP MAG</span>
</Panel>
