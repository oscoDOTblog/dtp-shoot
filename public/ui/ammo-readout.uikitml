<!--
  DTP Shoot bench ammo readout: live magazine state plus the two settings the
  player can change without leaving the range (ammo mode, magazine size).
  Placed at ~0.15 node scale so 176 units reads as a small instrument panel.
  Dark scheme at runtime, light in editor previews, so text colors have :dark.
-->
<style>
  .ammo-root {
    flex-direction: column;
    width: 176;
    padding-top: 8;
    padding-bottom: 9;
    padding-left: 11;
    padding-right: 11;
    gap: 1;
  }

  .ammo-label {
    color: #6b5a00;
    font-size: 7.5;
    font-weight: 700;
    letter-spacing: 0.9;
  }

  .ammo-label:dark {
    color: #f5d90a;
  }

  .ammo-value {
    color: #1c1d20;
    font-size: 30;
    font-weight: 700;
    line-height: 1;
  }

  .ammo-value:dark {
    color: #fafaf7;
  }

  .ammo-hint {
    margin-top: 1;
    color: #4a4b50;
    font-size: 10.5;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2;
  }

  .ammo-hint:dark {
    color: #d3d6dc;
  }

  .ammo-alert {
    margin-top: 2;
    color: #a03000;
    font-size: 10.5;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.2;
  }

  .ammo-alert:dark {
    color: #ff8a4a;
  }

  .mode-row {
    flex-direction: row;
    align-items: center;
    gap: 4;
    margin-top: 2;
  }

  .mode {
    height: 18;
    min-width: 0;
    width: 70;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 3;
    border-width: 0.6;
    border-color: #b3ad9c;
    background-color: #e6e1d3;
    color: #33343a;
    font-size: 8;
    font-weight: 700;
    cursor: pointer;
  }

  .mode:dark {
    border-color: #5c6069;
    background-color: #33363d;
    color: #d3d6dc;
  }

  .mode-on {
    border-color: #f5d90a;
    background-color: #f5d90a;
    color: #17181b;
  }

  .mode-on:dark {
    border-color: #f5d90a;
    background-color: #f5d90a;
    color: #17181b;
  }

  .mode-reloading {
    width: 76;
  }

  .weapon-label {
    margin-top: 5;
  }

  .size-row {
    flex-direction: row;
    align-items: center;
    gap: 5;
    margin-top: 3;
  }

  .size-label {
    width: 46;
    color: #4a4b50;
    font-size: 7.5;
    font-weight: 700;
    letter-spacing: 0.55;
  }

  .size-label:dark {
    color: #9ea3ad;
  }

  .step {
    height: 18;
    min-width: 0;
    width: 18;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 3;
    border-width: 0.6;
    border-color: #b3ad9c;
    background-color: #e6e1d3;
    color: #33343a;
    font-size: 12;
    font-weight: 700;
    cursor: pointer;
  }

  .step:dark {
    border-color: #5c6069;
    background-color: #33363d;
    color: #d3d6dc;
  }

  .size-value {
    width: 18;
    color: #1c1d20;
    font-size: 14;
    font-weight: 700;
    text-align: center;
  }

  .size-value:dark {
    color: #fafaf7;
  }

  .height-row {
    flex-direction: row;
    align-items: center;
    gap: 5;
    margin-top: 3;
  }

  .height-label {
    width: 46;
    color: #4a4b50;
    font-size: 7.5;
    font-weight: 700;
    letter-spacing: 0.55;
  }

  .height-label:dark {
    color: #9ea3ad;
  }

  .height-value {
    width: 34;
    color: #1c1d20;
    font-size: 10;
    font-weight: 700;
    text-align: center;
  }

  .height-value:dark {
    color: #fafaf7;
  }
</style>
<Panel class="ammo-root">
  <span class="ammo-label">MAGAZINE</span>
  <span id="ammo-value" class="ammo-value">8 / 8</span>
  <span id="ammo-hint" class="ammo-hint">READY</span>
  <span class="ammo-label weapon-label">WEAPON</span>
  <div class="mode-row">
    <div id="weapon-pistol" class="mode">PISTOL</div>
    <div id="weapon-smg" class="mode">SMG</div>
  </div>
  <div class="mode-row">
    <div id="mode-unlimited" class="mode">UNLIMITED</div>
    <div id="mode-reloading" class="mode mode-reloading">RELOADING</div>
  </div>
  <div id="mag-size-row" class="size-row">
    <span class="size-label">MAG SIZE</span>
    <div id="mag-minus" class="step">-</div>
    <span id="mag-size-value" class="size-value">8</span>
    <div id="mag-plus" class="step">+</div>
  </div>
  <div class="height-row">
    <span class="height-label">HEIGHT</span>
    <div id="height-minus" class="step">-</div>
    <span id="height-value" class="height-value">0.00 m</span>
    <div id="height-plus" class="step">+</div>
  </div>
  <span id="ammo-alert" class="ammo-alert" style="display: none">PRESS A TO DROP MAG</span>
</Panel>
